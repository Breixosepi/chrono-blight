# ==========================================
# Gitignore para Chrono Blight (Python / Gale / Pygame)
# ==========================================

# Entornos virtuales
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Byte-compiled / Archivos generados por Python
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
*.pyd
.Python

# Distribución y empaquetado
build/
dist/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Archivos de configuración de editores / IDEs
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo
*~

# Archivos del sistema operativo
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Thumbs.db:encryptable
Desktop.ini

# Logs y volcados de depuración
*.log
crash_dump_*
debug.txt
*.log.*

# Caches de herramientas de testing y linting
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Archivos temporales y de scratch de IA/desarrollo
.system_generated/
.tempmediaStorage/
scratch/

# Partidas guardadas locales
saves/
*.sav

